# GRIDWISE local development configuration.
# Copy to .env (`make setup` does this). Values here are for local development only;
# never reuse them in a shared or deployed environment.
#
# Passwords are pasted into connection URLs as-is: use letters, digits, "_" and "-" only.

# --- Host ports (change these if a port is already in use on your machine) ---
POSTGRES_PORT=5450
API_PORT=8020
WEB_PORT=3100

# --- PostgreSQL 18 (TimescaleDB image; hypertables arrive in P2) ---
POSTGRES_DB=gridwise
# Bootstrap superuser "postgres". No application connects with it; only the integration
# tests do, to create and drop their throwaway databases.
POSTGRES_PASSWORD=gridwise_admin_local_dev_only
# Role that runs migrations and owns the schema (not a superuser).
GRIDWISE_DB_OWNER_PASSWORD=gridwise_owner_local_dev_only
# Role the API connects as (not a superuser, no BYPASSRLS, owns nothing).
GRIDWISE_DB_APP_PASSWORD=gridwise_app_local_dev_only
GRIDWISE_DB_WORKER_PASSWORD=gridwise_worker_local_dev_only
# The three roles are created when the database volume is first initialised. After changing
# a password here, run `make reset-db` (this deletes local data) and `make up`.

# --- API (when it runs on the host; Docker Compose builds its own in-network URLs) ---
GRIDWISE_ENVIRONMENT=local
GRIDWISE_LOG_LEVEL=INFO
# "json" for machines, "console" for humans. Containers always log JSON.
GRIDWISE_LOG_FORMAT=console
# Runtime role. The API reads this and nothing else to reach the database.
GRIDWISE_DATABASE_URL=postgresql+psycopg://gridwise_app:gridwise_app_local_dev_only@localhost:5450/gridwise
# Owner role. Only Alembic reads this (`make migrate`).
GRIDWISE_MIGRATION_DATABASE_URL=postgresql+psycopg://gridwise_owner:gridwise_owner_local_dev_only@localhost:5450/gridwise
# Worker role. Only the simulation worker reads this (decision 0011).
GRIDWISE_WORKER_DATABASE_URL=postgresql+psycopg://gridwise_worker:gridwise_worker_local_dev_only@localhost:5450/gridwise
# Superuser. Only the integration tests read this.
GRIDWISE_TEST_ADMIN_DATABASE_URL=postgresql+psycopg://postgres:gridwise_admin_local_dev_only@localhost:5450/postgres
# The fixed development tenant. Only valid when GRIDWISE_ENVIRONMENT is local or test; the
# API refuses to start with it anywhere else. It is the organisation `make seed-demo`
# creates. There is no authentication yet: this selects a tenant, it does not protect one.
GRIDWISE_DEV_ORGANIZATION_ID=d0000000-0000-4000-8000-000000000001
# JSON list of host names the API answers to (the Host header without its port). Requests
# naming any other host are refused, which blocks DNS-rebinding pages. Default:
# GRIDWISE_ALLOWED_HOSTS=["localhost","127.0.0.1","::1"]
# JSON list of browser origins allowed to call the API (host runs only; Compose derives
# its own value from WEB_PORT).
GRIDWISE_CORS_ORIGINS=["http://localhost:3100"]

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8020
