{
  "name": "gridwise",
  "private": true,
  "description": "GRIDWISE — smart grid digital twin (simulation, monitoring and decision support).",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @gridwise/web dev",
    "build": "pnpm --filter @gridwise/web build",
    "start": "pnpm --filter @gridwise/web start",
    "typecheck": "pnpm --filter @gridwise/web typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @gridwise/web test",
    "test:e2e": "pnpm --filter @gridwise/web test:e2e",
    "check:bundle": "node scripts/check-web-bundle.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:bundle"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.4.6",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
